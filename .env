# Dynamically determine the absolute path to the Git root (ansible_foundation)
export PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "project root found: ${PROJECT_ROOT}"

# Absolute paths based on project root for maximum stability
export MOLECULE_HOSTS_FILE="$PROJECT_ROOT/ansible_template/inventory/production.yml"
export MOLECULE_GROUP_VARS_DIR="$PROJECT_ROOT/ansible_template/inventory/group_vars/"
export MOLECULE_HOST_VARS_DIR="$PROJECT_ROOT/ansible_template/inventory/host_vars/"
# change this, if your vault_pass is located differently
export ANSIBLE_VAULT_PASSWORD_FILE="$PROJECT_ROOT/.vault_pass"


# generate a private/public key combination and modify to your needs
export ANSIBLE_PRIVATE_KEY_FILE="$HOME/.ssh/local_net_key"

# remove this line if you want to use vim
# defines the editor for ansible-vault
export EDITOR="nano"

echo "MOLECULE_HOSTS_FILE: ${MOLECULE_HOSTS_FILE}"
echo "MOLECULE_GROUP_VARS_DIR: ${MOLECULE_GROUP_VARS_DIR}"
echo "MOLECULE_HOST_VARS_DIR: ${MOLECULE_HOST_VARS_DIR}"
echo "ANSIBLE_VAULT_PASSWORD_FILE: ${ANSIBLE_VAULT_PASSWORD_FILE}"

# Keep Ansible output clean
export ANSIBLE_PYTHON_INTERPRETER="auto_silent"
# {{ ansible_managed }}

# Loki Configuration for monitoring Systemd logs
# Generated by Ansible - local adjustments will be overwritten

schema: v14
resolution: 3

ingester:
  wal:
    dir: /tmp/ingester wal

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v14
      index:
        prefix: index_
        period: 24h

ruler:
  alertmanager_url: http://localhost.9093

distributor:
  ingester:
    response_timeout: 1m
    max_uploads_per_second: 10

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100
    max_cached_bytes_per_query: 10MiB
    min_size_to_cache: 1KiB

chunk_store_config:
  max_look_back_period: 0s

storage:
  filesystem:
    directory: /tmp/loki

limits_config:
  enforce_metric_name: false
  reject_old_samples: true
  reject_old_samples_max_age: 168h

analytics:
  reporting_enabled: false

# Enable OTLP receiver
server:
  http_listen_port: 3100
  grpc_listen_port: 9096

limits_config:
  chunk_encoding_compression_config:
    type: gzip
